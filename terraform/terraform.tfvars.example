# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.
# ---------------------------------------------------------------------------

# SSH public keys allowed in as 'takadmin'. Paste the contents of your
# ~/.ssh/id_ed25519.pub (or similar).
ssh_public_keys = [
  "ssh-ed25519 AAAA... you@laptop",
]

# Your own public IP(s) — only these can reach SSH and the admin web UI.
# `make doctor` prints your current public IP.
admin_ips = [
  "203.0.113.10",
]

# Where the server should live. fi-hel1 / fi-hel2 = Helsinki, Finland.
zone = "fi-hel1"

# Server size. OpenTAKServer's full stack wants >= 4 GB RAM.
plan = "2xCPU-4GB"

# PIN the app version. Replace "master" with a validated tag/commit before a
# real operation so deploys are reproducible.
compose_ref = "master"

# Optional hardening toggle (default false = hardened): only set true if field
# users need the CloudTAK *browser* client. ATAK/iTAK/WinTAK apps do NOT need
# this. If you enable it, change the default admin password first.
# open_web_ui_to_world = false
